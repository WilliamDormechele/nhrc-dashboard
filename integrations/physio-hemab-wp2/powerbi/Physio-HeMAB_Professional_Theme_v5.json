    "multiRowCard": {
      "*": {
        "card": [
          {
            "outlineWeight": 2,
            "barShow": true,
            "barWeight": 2
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "trendline": [
          {
            "transparency": 20
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "bold": true,
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#17324D"
              }
            }
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": false,
            "position": "aboveValue",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#61758A"
              }
            }
          }
        ],
        "layout": [
          {
            "$id": "default",
            "cellPadding": 5,
            "paddingIndividual": false,
            "paddingUniform": 6,
            "backgroundShow": false
          }
        ],
        "spacing": [
          {
            "$id": "default",
            "customizeSpacing": true,
            "verticalSpacing": 0
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "tileShape": "rectangleRoundedByPixel",
            "rectangleRoundedCurve": 8
          }
        ],
        "padding": [
          {
            "$id": "default",
            "paddingUniform": 6,
            "paddingIndividual": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "alignment": "left",
            "titleWrap": true
          }
        ]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "layout": [
