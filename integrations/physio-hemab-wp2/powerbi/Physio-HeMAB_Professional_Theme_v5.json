{
  "name": "Physio-HeMAB Professional v5",
  "dataColors": [
    "#2F6B9A",
    "#0F766E",
    "#C9912B",
    "#5B6B7A",
    "#4C78A8",
    "#59A14F",
    "#B54747",
    "#7A5195",
    "#F28E2B",
    "#76B7B2"
  ],
  "foreground": "#20364D",
  "foregroundNeutralSecondary": "#61758A",
  "foregroundNeutralTertiary": "#A8B6C3",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F7FA",
  "backgroundNeutral": "#D9E2EA",
  "tableAccent": "#2F6B9A",
  "good": "#2E7D32",
  "neutral": "#C9912B",
  "bad": "#B54747",
  "maximum": "#2F6B9A",
  "center": "#C9912B",
  "minimum": "#DDEAF4",
  "null": "#A8B6C3",
  "hyperlink": "#2F6B9A",
  "visitedHyperlink": "#596780",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#17324D"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#20364D"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#20364D"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#61758A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "wordWrap": true
          }
        ],
        "line": [
          {
            "transparency": 0
          }
        ],
        "outline": [
          {
            "transparency": 0
          }
        ],
        "plotArea": [
          {
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": true,
            "gridlineStyle": "dotted",
            "concatenateLabels": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true,
            "gridlineStyle": "dotted"
          }
        ],
        "y2Axis": [
          {
            "show": true
          }
        ],
        "title": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#20364D"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCE5ED"
              }
            },
            "width": 1,
            "radius": 8
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#B3B0AD"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "transparency": 0,
            "foregroundColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "border": true
          },
          {
            "$id": "Available",
            "transparency": 0,
            "foregroundColor": {
              "solid": {
                "color": "#252423"
              }
            },
            "border": true
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "bubbles": [
          {
            "bubbleSize": -10,
            "preventOverflow": true,
            "markerRangeType": "auto"
          }
        ],
        "general": [
          {
            "responsive": true
          }
        ],
        "fillPoint": [
          {
            "show": true
          }
        ],
        "legend": [
          {
            "showGradientLegend": true
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "general": [
          {
            "responsive": true
          }
        ],
        "smallMultiplesLayout": [
          {
            "backgroundTransparency": 0,
            "gridLineType": "inner"
          }
        ],
        "forecast": [
          {
            "matchSeriesInterpolation": true
          }
        ],
        "seriesLabels": [
          {
            "enableBackground": true,
            "leaderLines": true,
            "seriesMatchColor": true
          }
        ]
      }
    },
    "map": {
      "*": {
        "bubbles": [
          {
            "bubbleSize": -10,
            "markerRangeType": "auto"
          }
        ]
      }
    },
    "azureMap": {
      "*": {
        "bubbleLayer": [
          {
            "bubbleRadius": 8,
            "minBubbleRadius": 8,
            "maxRadius": 40
          }
        ],
        "barChart": [
          {
            "barHeight": 3,
            "thickness": 3
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "RightCenter"
          }
        ],
        "labels": [
          {
            "labelStyle": "Data value, percent of total"
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "RightCenter"
          }
        ],
        "labels": [
          {
            "labelStyle": "Data value, percent of total"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "rowHeaders": [
          {
            "showExpandCollapseButtons": true,
            "legacyStyleDisabled": true
