# Physio-HeMAB WP2
# Copy these names into D:\Git\nhrc-dashboard\.env
# Never commit real tokens, passwords or credentials.

# REDCap project PID 410: HeMAB Ghana Main
PHYSIO_HEMAB_MAIN_REDCAP_API_URL=https://redcap-test.uk-halle.de/api/
PHYSIO_HEMAB_MAIN_REDCAP_API_TOKEN=
PHYSIO_HEMAB_MAIN_REDCAP_RECORD_ID_FIELD=record_id

# REDCap project PID 411: HeMAB Ghana Devices
PHYSIO_HEMAB_DEVICES_REDCAP_API_URL=https://redcap-test.uk-halle.de/api/
PHYSIO_HEMAB_DEVICES_REDCAP_API_TOKEN=
PHYSIO_HEMAB_DEVICES_REDCAP_RECORD_ID_FIELD=record_id

# PostgreSQL monitoring layer
PHYSIO_HEMAB_DB_HOST=127.0.0.1
PHYSIO_HEMAB_DB_PORT=5437
PHYSIO_HEMAB_DB_NAME=physio_hemab_wp2
PHYSIO_HEMAB_DB_USER=physio_hemab
PHYSIO_HEMAB_DB_PASSWORD=
PHYSIO_HEMAB_DB_SSLMODE=disable

PHYSIO_HEMAB_REQUEST_TIMEOUT_SECONDS=60

# Power BI
PHYSIO_HEMAB_POWERBI_REPORT_ID=
PHYSIO_HEMAB_POWERBI_GROUP_ID=
